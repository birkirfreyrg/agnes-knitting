# Copy to .env. Generate PAYLOAD_SECRET with: openssl rand -hex 32
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/agnes_fresh
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required on Vercel. Leave empty for local uploads.
BLOB_READ_WRITE_TOKEN=
# Optional Instagram feed: server-only credentials; never use NEXT_PUBLIC_ here.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional locally; configure for password reset emails in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@agnesknitting.is

# Used only by the one-time editor bootstrap command.
INITIAL_EDITOR_EMAIL=birkirgudbjartsson@gmail.com
